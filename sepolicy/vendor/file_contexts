# The stock HIDL gatekeeper is not labeled by the sm8650 Qualcomm policy.
/(vendor|system/vendor)/bin/hw/android\.hardware\.gatekeeper@1\.0-service-qti    u:object_r:vendor_hal_gatekeeper_qti_exec:s0

# Fingerprint
/(vendor|system/vendor)/bin/hw/android\.hardware\.biometrics\.fingerprint@2\.3-service\.bangkk          u:object_r:hal_fingerprint_default_exec:s0
/(vendor|system/vendor)/bin/hw/android\.hardware\.biometrics\.fingerprint@2\.3-service\.miami           u:object_r:hal_fingerprint_default_exec:s0

# Stock fogos fingerprint HALs (started by init.oem.fingerprint2.sh).
/vendor/bin/hw/android\.hardware\.biometrics\.fingerprint@2\.1-goodixservice    u:object_r:hal_fingerprint_default_exec:s0
/vendor/bin/hw/android\.hardware\.biometrics\.fingerprint@2\.1-service-fpc    u:object_r:hal_fingerprint_default_exec:s0

# Perfmgr
/(vendor|system/vendor)/bin/hw/android\.hardware\.power-service\.pixel-libperfmgr    u:object_r:hal_power_default_exec:s0
/data/vendor/powerhal(/.*)?                                        u:object_r:powerhal_vendor_data_file:s0

# Network manager
/(vendor|system/vendor)/bin/netmgrd    u:object_r:vendor_netmgrd_exec:s0
/dev/socket/netmgr(/.*)?    u:object_r:vendor_netmgrd_socket:s0
/data/vendor/netmgr(/.*)?    u:object_r:vendor_netmgr_data_file:s0
/data/vendor/netmgr/recovery(/.*)?    u:object_r:vendor_netmgr_recovery_data_file:s0

# Legacy audio calibration
/dev/msm_audio_cal    u:object_r:audio_device:s0
/dev/msm_rtac    u:object_r:audio_device:s0

/sys/devices/platform/soc/4e00000\.ssusb/4e00000\.dwc3/xhci-hcd\.[0-9]+\.auto/usb[0-9]+/[0-9]+-[0-9]+(\.[0-9]+)*/wakeup(/.*)?    u:object_r:sysfs_wakeup:s0

# Keep stock vendor helpers in vendor domains under enforcing SELinux.
/vendor/bin/init\.mmi\.display\.sh    u:object_r:vendor_init_display_exec:s0
/vendor/bin/mbm_spy    u:object_r:vendor_mmi_boot_exec:s0

# Stock USB setup uses the Qualcomm init-shell policy.
/vendor/bin/init\.mmi\.usb\.sh    u:object_r:vendor_qti_init_shell_exec:s0
/vendor/bin/init\.mmi\.block_perm\.sh    u:object_r:vendor_init_block_perm_exec:s0
/dev/block/platform/soc/4804000\.ufshc/by-name/(hob|dhob|clogo|cid|logs)    u:object_r:vendor_mmi_config_block_device:s0

# The AW882xx codec reads its factory calibration from a kernel worker.
/mnt/vendor/persist/factory/audio/aw_cali\.bin    u:object_r:vendor_aw_cali_file:s0
