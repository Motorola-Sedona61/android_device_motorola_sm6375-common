# Allow the module-signature lookup to search the loader's inherited keyring.
allow kernel vendor_modprobe:key search;

# AW882xx factory impedance calibration is read-only during codec startup.
type vendor_aw_cali_file, file_type, vendor_persist_type;
allow kernel { mnt_vendor_file vendor_persist_audio_file }:dir search;
allow kernel vendor_aw_cali_file:file r_file_perms;
