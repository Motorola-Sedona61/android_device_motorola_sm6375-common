type vendor_init_block_perm, domain;
type vendor_init_block_perm_exec, exec_type, vendor_file_type, file_type;
type vendor_mmi_config_block_device, dev_type;
init_daemon_domain(vendor_init_block_perm)

allow vendor_init_block_perm vendor_toolbox_exec:file rx_file_perms;
allow vendor_init_block_perm self:capability { chown fowner };
allow vendor_init_block_perm block_device:dir search;
allow vendor_init_block_perm block_device:lnk_file r_file_perms;
# Only adjust ownership/modes of the partitions named by this helper.
allow vendor_init_block_perm { vendor_utags_block_device vendor_mmi_config_block_device }:blk_file { getattr setattr };
